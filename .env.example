# App
APP_NAME=VetStudy AI
APP_ENV=prod
DEBUG=false
HOST=0.0.0.0
PORT=8000
SENTRY_DSN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
WEBHOOK_URL=https://your-domain.tld
WEBHOOK_PATH=/telegram/webhook
TELEGRAM_CHAT_ID=0
ALLOWED_TELEGRAM_USER_IDS=123456789
ALLOWED_TELEGRAM_USERNAMES=

# Web owner auth
USER_ID_HASH_SALT=replace-with-long-random-salt
WEB_OWNER_TELEGRAM_ID=123456789
WEB_OWNER_PASSWORD=
# If hash contains "$", wrap it in single quotes to prevent Compose interpolation warnings.
WEB_OWNER_PASSWORD_HASH=''
WEB_OWNER_TOKEN=replace-with-long-random-token
WEB_SESSION_SECRET=replace-with-long-random-session-secret
WEB_SESSION_TTL_SECONDS=900
WEB_LOGIN_RATE_LIMIT_COUNT=8
WEB_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
WEB_ADMIN_RATE_LIMIT_COUNT=120
WEB_ADMIN_RATE_LIMIT_WINDOW_SECONDS=60

# Data stores
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/vetstudy
REDIS_URL=redis://redis:6379/0

# Media/document jobs
MEDIA_JOBS_STREAM=media:document_index_jobs
MEDIA_JOBS_GROUP=media-indexers
MEDIA_JOBS_CONSUMER=
MEDIA_JOBS_BLOCK_MS=1000
MEDIA_JOBS_RECLAIM_IDLE_MS=900000
MEDIA_JOBS_STALL_WARN_AFTER_S=600
MEDIA_JOBS_STALL_PENDING_THRESHOLD=10
MEDIA_JOBS_STALL_LOG_INTERVAL_S=60
MEDIA_STORAGE_PATH=./data/uploads
MAX_VOICE_FILE_SIZE_BYTES=20971520
MAX_IMAGE_FILE_SIZE_BYTES=10485760
MAX_DOCUMENT_FILE_SIZE_BYTES=31457280
MULTIMODAL_OCR_ENABLED=false
MULTIMODAL_VISION_ENABLED=false

# Evidence/source policy
EVIDENCE_SOURCES_PATH=quality/evidence_sources/sources.json

# LLM routing
# Dual-risk mode requires both LOW_RISK and HIGH_RISK provider/model pairs to be explicitly set.
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=openrouter
LLM_PRIMARY_MODEL=llama-3.1-8b-instant
LLM_FALLBACK_MODEL=openai/gpt-oss-20b:free
LLM_CLASSIFICATION_PROVIDER=groq
LLM_CLASSIFICATION_MODEL=llama-3.1-8b-instant
LLM_SUMMARY_PROVIDER=groq
LLM_SUMMARY_MODEL=llama-3.1-8b-instant
# In APP_ENV=prod embeddings must use a real provider key and non-empty model.
LLM_EMBEDDINGS_PROVIDER=openai
LLM_EMBEDDINGS_MODEL=text-embedding-3-small
LLM_LOW_RISK_PROVIDER=gemini
LLM_LOW_RISK_MODEL=gemini-2.5-flash-lite
LLM_HIGH_RISK_PROVIDER=openai
LLM_HIGH_RISK_MODEL=gpt-5.4
LLM_REQUEST_TIMEOUT_S=30
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_BACKOFF_S=0.5
LLM_MAX_REQUEST_TOKENS=4096
LLM_COST_ESTIMATE_INPUT_PER_1K=0.0005
LLM_COST_ESTIMATE_OUTPUT_PER_1K=0.0015

# Providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=

# Cost safety
DAILY_COST_LIMIT_USD=1.0
MONTHLY_COST_LIMIT_USD=10.0
GLOBAL_DAILY_COST_LIMIT_USD=1.0
GLOBAL_MONTHLY_COST_LIMIT_USD=10.0
